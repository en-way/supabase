# Cloudflare Pages Custom Edge Response Headers

# Global Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Immutable 26-Letter Dictionary Shards: 1 Year Edge & Client Cache
/dict/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Static Individual Exam Details: 1 Year Edge & Client Cache (Immutable historical exams)
/data/exams/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Version check for static exam mirror (revalidate frequently)
/data/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60, must-revalidate
  Access-Control-Allow-Origin: *

# Specific static lobby index files: short edge cache with quick revalidation
/data/categories.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *

/data/exams.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=3600
  Access-Control-Allow-Origin: *

# Fallback for other data assets
/data/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Next.js Static Chunks and Fingerprinted Bundles
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Web Manifest & Favicon / PWA Icon
/favicon.ico
  Cache-Control: public, max-age=86400

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/icon.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *
